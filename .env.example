# Database (Railway provides this automatically when you add a PostgreSQL plugin)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Server
PORT=5000
NODE_ENV=production

# Authentication
SESSION_SECRET=generate-a-random-string-here
ADMIN_PASSWORD=change-this-before-first-deploy

# Set to "true" if running behind a reverse proxy (Railway, nginx, etc.)
TRUST_PROXY=true
